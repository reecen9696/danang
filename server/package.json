{
  "name": "ace-defense-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Colyseus server for Ace Defense co-op",
  "main": "build/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "rimraf build && node build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke.mjs",
    "test:ff": "node test/ff.mjs",
    "test:targeting": "tsx test/targeting.ts",
    "test:village": "tsx test/village.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.16.24",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/three": "^0.169.0",
    "colyseus.js": "^0.16.22",
    "esbuild": "^0.24.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true
  }
}
